{
  "openapi": "3.0.1",
  "info": {
    "title": "pagoPA - A.C.A. API",
    "description": "API for A.C.A. service",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "https://api.uat.platform.pagopa.it/aca/v1"
    }
  ],
  "paths": {
        "/paCreatePosition": {
            "post": {
                "description": "Create / Update / Invalidate a debt position.",
                "operationId": "newDebtPosition",
                "summary": "Create / Update / Invalidate a debt position",
                "tags": [
                    "ACA"
                ],
                "parameters": [
                    {
                        "name": "newDebtPositionRequest",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/NewDebtPositionRequest"
                        }
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "create / update / invalidate debt position successfully",
                        "schema": {
                            "$ref": "#/definitions/DebtPositionResponse"
                        },
                        "examples": {
                            "application/json": {
                                "paFiscalCode": "string",
                                "companyName": "string",
                                "entityType": "string",
                                "entityFiscalCode": "string",
                                "entityFullName": "string",
                                "iuv": "string",
                                "nav": "string",
                                "amount": 0,
                                "description": "string",
                                "expirationDate": "string",
                                "iban": "string",
                                "postalIban": "string",
                                "switchToExpired": true,
                                "status": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Formally invalid input",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "value": {
                                    "invalidInput": {
                                        "type": "https://example.com/problem/",
                                        "title": "string",
                                        "status": 400,
                                        "detail": "Formally invalid input"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Entity not found",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "type": "https://example.com/problem/",
                                "title": "Invocation exception",
                                "status": 404,
                                "detail": "Error while invalidate debit position. Debit position not found with {iupd}"
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict into requested action",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "type": "https://example.com/problem/",
                                "title": "Invocation exception",
                                "status": 409,
                                "detail": "Error while create new debit position conflict into request"
                            }
                        }
                    },
                    "422": {
                        "description": "Can not perform the requested action on debit position",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "value": {
                                    "type": "https://example.com/problem/",
                                    "title": "Unprocessable request",
                                    "status": 422,
                                    "detail": "Can not perform the requested action on debit position"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "value": {
                                    "type": "https://example.com/problem/",
                                    "title": "string",
                                    "status": 500,
                                    "detail": "Internal server error"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Bad gateway",
                        "schema": {
                            "$ref": "#/definitions/ProblemJson"
                        },
                        "examples": {
                            "application/json": {
                                "value": {
                                    "type": "https://example.com/problem/",
                                    "title": "string",
                                    "status": 502,
                                    "detail": "Bad gateway, error while execute request"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "NewDebtPositionRequest": {
            "type": "object",
            "description": "Request body for creating a new transaction",
            "required": [
                "paFiscalCode",
                "entityType",
                "entityFiscalCode",
                "entityFullName",
                "iuv",
                "amount",
                "description",
                "expirationDate"
            ],
            "properties": {
                "paFiscalCode": {
                    "type": "string",
                    "maxLength": 11,
                    "minLength": 11,
                    "example": "12345678910"
                },
                "entityType": {
                    "type": "string",
                    "enum": [
                        "F",
                        "G"
                    ],
                    "example": "G"
                },
                "entityFiscalCode": {
                    "type": "string",
                    "minLength": 2,
                    "example": "12345678910"
                },
                "entityFullName": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Full Name"
                },
                "iuv": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "00000000000000000"
                },
                "nav": {
                    "type": "string",
                    "description": "notice number, if not specified it will created using the following pattern: 3 + iuv",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "30000000000000000"
                },
                "amount": {
                    "$ref": "#/definitions/AmountEuroCents"
                },
                "description": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "ACA Debt Position description"
                },
                "expirationDate": {
                    "type": "string",
                    "format": "date-time"
                },
                "iban": {
                    "type": "string",
                    "maxLength": 27,
                    "minLength": 27,
                    "example": "IT0000000000000000000000000"
                },
                "postalIban": {
                    "type": "string",
                    "maxLength": 27,
                    "minLength": 27,
                    "example": "IT60X0542811101000000123456"
                },
                "switchToExpired": {
                    "type": "boolean",
                    "default": false,
                    "example": true
                },
                "payStandIn": {
                    "type": "boolean",
                    "default": true,
                    "example": true
                }
            },
            "example": {
                "paFiscalCode": "12345678910",
                "entityType": "G",
                "entityFiscalCode": "12345678910",
                "entityFullName": "Full Name",
                "iuv": "00000000000000000",
                "nav": "30000000000000000",
                "amount": 100,
                "description": "ACA Debt Position description",
                "expirationDate": "string",
                "iban": "IT0000000000000000000000000",
                "postalIban": "IT60X0542811101000000123456",
                "switchToExpired": false,
                "payStandIn": true
            }
        },
        "DebtPositionResponse": {
            "type": "object",
            "properties": {
                "paFiscalCode": {
                    "type": "string"
                },
                "companyName": {
                    "type": "string"
                },
                "entityType": {
                    "type": "string"
                },
                "entityFiscalCode": {
                    "type": "string"
                },
                "entityFullName": {
                    "type": "string"
                },
                "iuv": {
                    "type": "string"
                },
                "nav": {
                    "type": "string"
                },
                "amount": {
                    "type": "integer",
                    "format": "int64"
                },
                "description": {
                    "type": "string"
                },
                "expirationDate": {
                    "type": "string",
                    "format": "local-date-time"
                },
                "iban": {
                    "type": "string"
                },
                "postalIban": {
                    "type": "string"
                },
                "switchToExpired": {
                    "type": "boolean"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "AmountEuroCents": {
            "type": "integer",
            "description": "Amount for payments, in eurocents",
            "maximum": 99999999999,
            "minimum": 0,
            "example": 100
        },
        "ProblemJson": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "An absolute URI that identifies the problem type. When dereferenced,\nit SHOULD provide human-readable documentation for the problem type\n(e.g., using HTML).",
                    "format": "uri",
                    "default": "about:blank",
                    "example": "https://example.com/problem/"
                },
                "title": {
                    "type": "string",
                    "description": "A short, summary of the problem type. Written in english and readable\nfor engineers (usually not suited for non technical stakeholders and\nnot localized); example: Service Unavailable"
                },
                "status": {
                    "type": "integer",
                    "description": "The HTTP status code generated by the origin server for this occurrence\nof the problem.",
                    "format": "int32",
                    "maximum": 600,
                    "exclusiveMaximum": true,
                    "minimum": 100,
                    "example": 400
                },
                "detail": {
                    "type": "string",
                    "description": "A human readable explanation specific to this occurrence of the\nproblem."
                },
                "instance": {
                    "type": "string",
                    "description": "An absolute URI that identifies the specific occurrence of the problem.\nIt may or may not yield further information if dereferenced.",
                    "format": "uri"
                }
            }
        }
    },
    "tags": [
        {
            "name": "ACA",
            "description": "Api's for performing a debt position census",
            "externalDocs": {
                "url": "https://pagopa.atlassian.net/wiki/spaces/PPR/pages/649265163/ACA+-+Dati+in+input+API",
                "description": "Technical specifications"
            }
        }
    ]
}
